      "parameters": {
        "jsCode": "// ---------- Inputs ----------\nconst ai = $json.output ?? $json;            // AI result from Analyze Resume\nconst data = $('Merge').item.json;           // form answers + job role rules\nconst upload = $('Upload Resume').item.json; // Drive file info\n\n// ---------- Helpers ----------\nconst toList = s => String(s || '').split(',').map(x => x.trim()).filter(Boolean);\nconst norm = s => String(s).toLowerCase().replace(/[^a-z0-9]/g, ''); // \"Node.js\" -> \"nodejs\"\nconst round1 = n => Math.round(n * 10) / 10;\n\n// ---------- 1. Keywords ----------\nconst mustList = toList(data.must_have);\nconst niceList = toList(data.nice_to_have);\nconst aiMust = new Set((ai.matched_must_have || []).map(norm));\nconst aiNice = new Set((ai.matched_nice_to_have || []).map(norm));\n\nconst matchedMust = mustList.filter(k => aiMust.has(norm(k)));\nconst missingMust = mustList.filter(k => !aiMust.has(norm(k)));\nconst matchedNice = niceList.filter(k => aiNice.has(norm(k)));\n\n// ---------- 2. Experience (merge overlapping jobs) ----------\nconst now = new Date();\nconst nowMonth = now.getFullYear() * 12 + now.getMonth();\n\n// \"2023-04\" -> month number, \"present\" -> this month\nfunction toMonth(s) {\n  if (!s) return null;\n  if (/present|current|now/i.test(s)) return nowMonth;\n  const m = String(s).match(/(\\d{4})(?:-(\\d{1,2}))?/);\n  if (!m) return null;\n  return Number(m[1]) * 12 + (m[2] ? Number(m[2]) - 1 : 0);\n}\n\n// Total months covered by a list of periods, counting overlaps once\nfunction totalMonths(periods) {\n  const sorted = periods.sort((a, b) => a.start - b.start);\n  let total = 0, curStart = null, curEnd = null;\n  for (const p of sorted) {\n    if (curStart === null) { curStart = p.start; curEnd = p.end; continue; }\n    if (p.start <= curEnd) { curEnd = Math.max(curEnd, p.end); }       // overlap -> extend\n    else { total += curEnd - curStart; curStart = p.start; curEnd = p.end; }\n  }\n  if (curStart !== null) total += curEnd - curStart;\n  return total;\n}\n\nconst jobs = [], internships = [];\nfor (const j of ai.jobs || []) {\n  const start = toMonth(j.start), end = toMonth(j.end);\n  if (start === null || end === null || end < start) continue;\n  const period = { start, end: end + 1 };          // +1 so the end month counts\n  (String(j.type).toLowerCase() === 'internship' ? internships : jobs).push(period);\n}\n// Full-time jobs count fully, internships count half\nconst experienceYears = round1((totalMonths(jobs) + 0.5 * totalMonths(internships)) / 12);\n\n// ---------- 3. Score (out of 100) ----------\nconst minExp = Number(data.min_experience) || 0;\nconst mustScore = mustList.length ? (matchedMust.length / mustList.length) * 50 : 50;\nconst niceScore = niceList.length ? (matchedNice.length / niceList.length) * 25 : 25;\nconst expScore  = minExp === 0 ? 25 : Math.min(experienceYears / minExp, 1) * 25;\nconst score = Math.round(mustScore + niceScore + expScore);\n\n// ---------- 4. Verdict ----------\nconst verdict = score >= 85 ? 'Shortlisted' : score >= 80 ? 'Potential' : 'Not selected';\n\n// ---------- 5. Candidate ID + time ----------\nconst submitted = new Date(data.submittedAt);\nconst pad = n => String(n).padStart(2, '0');\nconst ist = new Date(submitted.getTime() + 330 * 60000); // shift to India time\nconst candidateId = `CAND-${String(ist.getUTCFullYear()).slice(2)}${pad(ist.getUTCMonth() + 1)}${pad(ist.getUTCDate())}${pad(ist.getUTCHours())}${pad(ist.getUTCMinutes())}${pad(ist.getUTCSeconds())}`;\n\nconst tips = (ai.tips || []).slice(0, 3);\n\nreturn {\n  json: {\n    candidate_id: candidateId,\n    applied_at: submitted.toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }),\n    name: data['Full Name'],\n    email: data['Email'],\n    phone: data['Phone Number'],\n    role: data.role,\n    score,\n    verdict,\n    experience_years: experienceYears,\n    matched_must_have: matchedMust.join(', '),\n    missing_must_have: missingMust.join(', '),\n    matched_nice: matchedNice.join(', '),\n    ai_summary: ai.summary || '',\n    tips: tips.map((t, i) => `${i + 1}. ${t}`).join('\\n'),\n    tips_list: tips,                                  // kept for the emails\n    resume_link: upload.webViewLink || '',\n    hr_decision: '',\n    score_breakdown: `Must-have ${Math.round(mustScore)}/50 + Nice ${Math.round(niceScore)}/25 + Experience ${Math.round(expScore)}/25`\n  }\n};"
      },
